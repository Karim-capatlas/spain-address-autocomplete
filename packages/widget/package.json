{
  "name": "@spain-address/widget",
  "version": "0.1.0",
  "type": "module",
  "description": "Framework-agnostic Spanish address autocomplete Web Component (StencilJS).",
  "main": "./dist/components/index.js",
  "module": "./dist/components/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./react": {
      "types": "./dist/react/components.ts",
      "import": "./dist/react/components.ts"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "stencil build",
    "dev": "stencil dev",
    "clean": "rm -rf dist loader"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@spain-address/core": "workspace:*"
  },
  "devDependencies": {
    "@stencil/core": "^4.44.0",
    "@stencil/react-output-target": "^1.6.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  }
}
